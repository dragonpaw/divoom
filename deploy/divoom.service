# divoom dashboard as a native systemd service on plugger (replaced the
# ghcr.io/dragonpaw/divoom container 2026-11-16). Installed by `make deploy`.
# /opt/divoom holds the binary + fonts/ + device-files/ (it reads them relative to
# the working dir). Env (API keys, frame MAC/IP, scene config): /srv/divoom/stack.env
# (root 0600). Cache (~/.cache/divoom in the container): /var/cache/divoom.
# USB: deploy/70-divoom-frame.rules gives group divoom the Times Frame for adb.
[Unit]
Description=divoom Times Frame dashboard
After=network-online.target
Wants=network-online.target
OnFailure=pushover-onfailure@%n.service

[Service]
User=divoom
Group=divoom
WorkingDirectory=/opt/divoom
EnvironmentFile=/srv/divoom/stack.env
# os.UserCacheDir() -> $XDG_CACHE_HOME/divoom = /var/cache/divoom; adb keeps keys in $HOME/.android.
Environment=XDG_CACHE_HOME=/var/cache HOME=/var/lib/divoom
CacheDirectory=divoom
StateDirectory=divoom
ExecStart=/opt/divoom/divoom serve
Restart=always
RestartSec=10
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
